# GEMINI_API_KEY: Configurado automáticamente por el entorno de Google AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base del servicio
APP_URL="MY_APP_URL"

# Puerto de escucha del servidor (Cloud Run inyecta PORT dinámico; por defecto 3000)
PORT="3000"

# MODO DE EJECUCIÓN (Opcional):
# Por defecto es "mock" (modo demostración con datos ficticios en memoria sin exigir secretos).
# Para activar conexión real con PostgreSQL/Supabase en desarrollo o producción, defina:
# APP_MODE="supabase"
APP_MODE="mock"

# CONFIGURACIÓN SUPABASE (Solo requerida si APP_MODE=supabase)
# URL del proyecto Supabase (ej: https://xyzcompany.supabase.co)
# SUPABASE_URL=
# Clave publicable de Supabase (SUPABASE_PUBLISHABLE_KEY / SUPABASE_ANON_KEY)
# SUPABASE_PUBLISHABLE_KEY=
# Clave secreta administrativa de servicio (exclusiva del servidor, NUNCA en el cliente)
# SUPABASE_SECRET_KEY=
# Secreto de firma de sesión (obligatorio y robusto en producción; en mock se usa valor seguro interno)
# SESSION_SECRET=
